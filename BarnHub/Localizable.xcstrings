    "Take your data with you. It never leaves your devices unless you explicitly share it." : {
      "comment" : "Privacy policy bullet point describing data export.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen Sie Ihre Daten mit. Sie verlassen niemals Ihre Geräte, es sei denn, Sie teilen sie ausdrücklich."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva tus datos contigo. Nunca salen de tus dispositivos a menos que los compartas explícitamente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva tus datos contigo. Nunca salen de tus dispositivos a menos que los compartas explícitamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emportez vos données avec vous. Elles ne quittent jamais vos appareils à moins que vous ne les partagiez explicitement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta i tuoi dati con te. Non lasciano mai i tuoi dispositivi a meno che tu non li condivida esplicitamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem je gegevens mee. Ze verlaten nooit je apparaten tenzij je ze expliciet deelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve seus dados com você. Eles nunca saem dos seus dispositivos a menos que você os compartilhe explicitamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta med dig dina data. De lämnar aldrig dina enheter om du inte uttryckligen delar dem."
          }
        }
      }
    },
    "Tap + to add feed items to this horse's daily plan." : {
