    "Permanently removes all horses, clients, transactions, vet records, farrier visits, supplies, and reminders from this device." : {
      "comment" : "A footer label under the \"Reset\" section of the data management view, explaining that deleting all data will permanently remove all stored information from the device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt dauerhaft alle Pferde, Klienten, Transaktionen, Tierarztberichte, Hufschmiedtermine, Bestände und Erinnerungen von diesem Gerät."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente todos los caballos, clientes, transacciones, historiales veterinarios, visitas del herrador, suministros y recordatorios de este dispositivo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente todos los caballos, clientes, transacciones, registros veterinarios, visitas del herrador, insumos y recordatorios de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement tous les chevaux, clients, transactions, dossiers vétérinaires, visites de maréchal-ferrant, articles et rappels de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove permanentemente tutti i cavalli, i clienti, le transazioni, i registri veterinari, le visite del maniscalco, gli articoli e i promemoria da questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert definitief alle paarden, klanten, transacties, dierenartsverslagen, hoefsmidbezoeken, voorraden en herinneringen van dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove permanentemente todos os cavalos, clientes, transações, registros veterinários, visitas do ferrador, itens e lembretes deste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla hästar, kunder, transaktioner, veterinärjournaler, hovslagarbesök, artiklar och påminnelser permanent från denna enhet."
